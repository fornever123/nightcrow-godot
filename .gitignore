/assets/image/ai-hd-20261020/
/assets/data/ai-hd-visuals.json
/scripts/presentation/ai_hd_visuals.gd
/scripts/presentation/ai_hd_visuals.gd.uid
/tests/test_ai_hd_visuals.gd
/tests/test_ai_hd_visuals.gd.uid
/tools/art/prepare_ai_hd_assets.cjs
/docs/ai-hd-assets-20261020/
/docs/ai-hd-visual/
