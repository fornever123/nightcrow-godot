; ===== [YG-MARK] 首页「断晓 · 断光」（YG 新增，全部改动都可以按 docs/YG-首页断光-删除清单.md 撤回）=====
; [YG-MARK] run/main_scene 指向 YG 新做的首页场景 res://scenes/yg_title_duanguang.tscn。
; [YG-MARK] 撤回：把下面 run/main_scene 改回 "res://scenes/rain_trial.tscn"，再删掉三处 yg_title 资源目录和首页场景、截图脚本。
; =====================================================================================================
config_version=5

[application]
config/name="雨夜河岸街 · 试玩版"
run/main_scene="res://scenes/yg_title_duanguang.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Supersample="*res://scripts/presentation/supersample.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_2d=2
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.125,0.129,0.173,1)

[physics]
common/physics_ticks_per_second=60

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[debug]
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

