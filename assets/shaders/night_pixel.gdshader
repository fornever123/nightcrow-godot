shader_type canvas_item;
// 夜景退后 + 像素化（第三轮节点 15/16，见 docs/HANDOFF-试玩版.md §14）。
// 画在所有夜景层之后、地形和角色之前（z = -75）：读屏幕纹理，只处理已经画好的夜景。
//   1) 退后调色：按屏幕高度，远处全强度，步道及以下 near_amt —— 去饱和、往冷蓝灰收对比、压暗，
//      让角色和地形从背景里跳出来；
//   2) 像素化：block×block（设计分辨率下 2×2）取平均；
//   3) 调色板量化：每个像素块取调色板里最近的颜色（调色板由 tools/art/make_night_palette.py
//      从夜景截图离线算出，写在下面 PAL 里）。
// 计算都按 1280×720 设计分辨率，窗口放大（canvas_items 拉伸）时像素块跟着放大。
uniform sampler2D screen_tex : hint_screen_texture, filter_linear;
uniform vec2 design = vec2(1280.0, 720.0);
uniform float block = 2.0;
uniform float y_full = 520.0;        // 这一行以上：全强度退后
uniform float y_near = 585.0;        // 这一行以下：near_amt
uniform float near_amt = 0.3;
uniform float desat = 0.25;
uniform vec3 pivot = vec3(0.20, 0.25, 0.36);
uniform float flatten = 0.17;
uniform float dim = 0.12;
uniform bool pixelate = true;
uniform bool quantize = true;

// @@PALETTE@@
const int PAL_N = 64;
const vec3 PAL[64] = vec3[64](
	vec3(0.0431, 0.0863, 0.1765),
	vec3(0.0588, 0.1020, 0.1059),
	vec3(0.0471, 0.0980, 0.2000),
	vec3(0.0196, 0.1098, 0.2863),
	vec3(0.0549, 0.1059, 0.2157),
	vec3(0.0549, 0.1176, 0.2353),
	vec3(0.0275, 0.1333, 0.3216),
	vec3(0.0627, 0.1294, 0.2549),
	vec3(0.0784, 0.1294, 0.2157),
	vec3(0.0667, 0.1412, 0.2784),
	vec3(0.0941, 0.1529, 0.2588),
	vec3(0.0431, 0.1608, 0.3529),
	vec3(0.0784, 0.1569, 0.2980),
	vec3(0.0824, 0.1686, 0.3176),
	vec3(0.0510, 0.1843, 0.3882),
	vec3(0.0941, 0.1843, 0.3294),
	vec3(0.1176, 0.1843, 0.2902),
	vec3(0.1333, 0.2039, 0.1686),
	vec3(0.0980, 0.1961, 0.3529),
	vec3(0.1294, 0.2078, 0.3294),
	vec3(0.0902, 0.2157, 0.4039),
	vec3(0.0667, 0.2275, 0.4549),
	vec3(0.1176, 0.2196, 0.3725),
	vec3(0.1686, 0.2275, 0.3098),
	vec3(0.1529, 0.2353, 0.3608),
	vec3(0.1412, 0.2431, 0.4000),
	vec3(0.1255, 0.2510, 0.4314),
	vec3(0.1020, 0.2745, 0.5098),
	vec3(0.2000, 0.2627, 0.3569),
	vec3(0.1529, 0.2784, 0.4588),
	vec3(0.1804, 0.2745, 0.4118),
	vec3(0.1961, 0.2980, 0.4510),
	vec3(0.1569, 0.3176, 0.5333),
	vec3(0.1922, 0.3137, 0.4863),
	vec3(0.2549, 0.3098, 0.3882),
	vec3(0.2157, 0.3373, 0.5137),
	vec3(0.2471, 0.3333, 0.4588),
	vec3(0.1765, 0.3529, 0.5922),
	vec3(0.2588, 0.3608, 0.5137),
	vec3(0.2353, 0.3765, 0.5647),
	vec3(0.3294, 0.3725, 0.4392),
	vec3(0.2941, 0.3882, 0.5333),
	vec3(0.2353, 0.4118, 0.6431),
	vec3(0.2980, 0.4078, 0.5686),
	vec3(0.2941, 0.4353, 0.6157),
	vec3(0.3686, 0.4235, 0.5176),
	vec3(0.3451, 0.4353, 0.5765),
	vec3(0.3490, 0.4627, 0.6196),
	vec3(0.3137, 0.4824, 0.6980),
	vec3(0.4000, 0.4745, 0.5961),
	vec3(0.4863, 0.4706, 0.4627),
	vec3(0.3882, 0.5020, 0.6510),
	vec3(0.4510, 0.5216, 0.6392),
	vec3(0.4235, 0.5725, 0.7451),
	vec3(0.5098, 0.5843, 0.6824),
	vec3(0.5843, 0.5843, 0.5961),
	vec3(0.6510, 0.6549, 0.6667),
	vec3(0.5725, 0.6784, 0.7765),
	vec3(0.9700, 0.6600, 0.3400),
	vec3(0.7294, 0.7294, 0.7294),
	vec3(0.7608, 0.8275, 0.8784),
	vec3(1.0000, 0.8600, 0.5600),
	vec3(0.8400, 0.9800, 0.7000),
	vec3(0.9300, 0.9500, 1.0000));
// @@END@@

vec3 nearest(vec3 c) {
	vec3 best = PAL[0];
	float bd = 1e9;
	for (int i = 0; i < PAL_N; i++) {
		vec3 d = PAL[i] - c;
		float e = dot(d * d, vec3(0.30, 0.50, 0.20));
		if (e < bd) {
			bd = e;
			best = PAL[i];
		}
	}
	return best;
}

void fragment() {
	vec2 dp = SCREEN_UV * design;                     // 设计分辨率下的像素坐标
	vec2 cell = pixelate ? (floor(dp / block) + 0.5) * block : dp;
	vec3 c = texture(screen_tex, cell / design).rgb;   // 双线性取在块中心 = 2×2 平均
	float m = 1.0 - smoothstep(y_full, y_near, cell.y);
	float k = near_amt + (1.0 - near_amt) * m;
	float lum = dot(c, vec3(0.299, 0.587, 0.114));
	c += (lum - c) * desat * k;
	c = pivot + (c - pivot) * (1.0 - flatten * k);
	c *= 1.0 - dim * k;
	if (quantize && PAL_N > 1) {
		c = nearest(c);
	}
	COLOR = vec4(c, 1.0);
}
